# Local custom rules for Network Incident Response Training
# These rules are specific to the training environment

# Training environment specific alerts
alert http any any -> 192.168.100.0/24 80 (msg:"TRAINING HTTP Access to Vulnerable Web Server"; flow:established,to_server; content:"Host:"; http_header; content:"vulnerable.local"; http_header; classtype:policy-violation; sid:9000001; rev:1;)

alert tcp any any -> 192.168.100.0/24 22 (msg:"TRAINING SSH Access to Training Environment"; flow:established,to_server; flowbits:set,ssh.training; classtype:policy-violation; sid:9000002; rev:1;)

# Simulated attack patterns for training
alert http any any -> any any (msg:"TRAINING Simulated SQL Injection Test"; flow:established,to_server; content:"' OR 1=1--"; http_uri; classtype:web-application-attack; sid:9000010; rev:1;)

alert http any any -> any any (msg:"TRAINING Simulated XSS Test"; flow:established,to_server; content:"<script>"; http_uri; classtype:web-application-attack; sid:9000011; rev:1;)

alert http any any -> any any (msg:"TRAINING Simulated Directory Traversal"; flow:established,to_server; content:"../"; http_uri; classtype:web-application-attack; sid:9000012; rev:1;)

# Training scenario specific rules
alert tcp any any -> any any (msg:"TRAINING Scenario 1 - SQL Injection Detection"; flow:established; content:"sqlmap"; classtype:web-application-attack; sid:9000100; rev:1;)

alert tcp any any -> any 22 (msg:"TRAINING Scenario 3 - SSH Brute Force Detection"; flags:S; threshold: type both, track by_src, seconds 30, count 3; classtype:attempted-reconnaissance; sid:9000300; rev:1;)

alert smtp any any -> any any (msg:"TRAINING Scenario 2 - Phishing Email Detection"; flow:established; content:"urgent"; content:"verify"; content:"account"; classtype:trojan-activity; sid:9000200; rev:1;)

# Custom training alerts for specific exercises
alert http any any -> any any (msg:"TRAINING Custom Alert - Suspicious User Agent String"; flow:established,to_server; content:"User-Agent:"; http_header; content:"TrainingBot"; http_header; classtype:policy-violation; sid:9000500; rev:1;)

alert dns any any -> any any (msg:"TRAINING Custom Alert - Suspicious DNS Query"; dns_query; content:"malicious.example"; classtype:trojan-activity; sid:9000501; rev:1;)

# Performance testing rules
alert icmp any any -> any any (msg:"TRAINING Performance Test - ICMP"; itype:8; sid:9000600; rev:1;)
alert tcp any any -> any 80 (msg:"TRAINING Performance Test - HTTP"; flow:established; sid:9000601; rev:1;)